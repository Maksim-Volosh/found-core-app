# Test environment — loaded by tests/conftest.py before any `app.*` import.
# Points at a second database inside the same dev Postgres container (see docker-compose.yaml's `db` service).
APP_CONFIG__DB__URL=postgresql+asyncpg://postgres_user:postgres_password@localhost:5432/found_core_test_db
APP_CONFIG__DB__ECHO=0

APP_CONFIG__BOT__TOKEN=123

APP_CONFIG__AUTH__SECRET_KEY=dev-only-insecure-secret-change-me
APP_CONFIG__AUTH__ALGORITHM=HS256
APP_CONFIG__AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_CONFIG__AUTH__INIT_DATA_TTL_SECONDS=300
